# TeraDrop Telegram bot — no official API / OFFICIAL_API_BASE_URL needed
BOT_TOKEN=123456:replace-me
OWNER_IDS=123456789
BOT_PUBLIC=true
AUTHORIZED_IDS=
FORCE_SUB_CHANNEL=
LOG_CHANNEL=
DUMP_CHANNEL=
MAINTENANCE=false
# Maximum requested upload size. The local Bot API path supports up to 2000 MB.
MAX_FILE_MB=2000
MAX_CONCURRENT=3
BOT_NAME=TeraDrop
BOT_USERNAME=TeraDropBot
WELCOME_TEXT=
CAPTION_TEMPLATE={filename}\n{size}
TERABOXDL_URL=https://www.teraboxdl.site
SOLVER_URL=http://caboose.proxy.rlwy.net:42271
TURNSTILE_SITEKEY=0x4AAAAAAC3x1HiBz5IFyj7s
# Keep this pointed at the local Bot API service for files above 49 MB.
BOT_API_URL=http://telegram-bot-api:8081
# Get these two values from https://my.telegram.org (required by docker-compose).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DOWNLOAD_DIR=/app/data/tmp
DATA_DIR=/app/data
HEALTH_PORT=8080
